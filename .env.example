# Progz Frontend — environment variables
# Copy to .env.local for local development.
# Never commit real values to version control.

# API base URL
# Local:  http://localhost:5002/api
# Prod:   /api  (Vercel proxies /api → progz-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:5002/api

# External compiler iframe base URL (optional in dev)
VITE_COMPILER_BASE_URL=https://uccompiler.urbancode.in
