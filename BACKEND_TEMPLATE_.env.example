CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ZEN_API_BASE_URL=
ZEN_API_KEY=
ZEN_DEFAULT_TRAINER_PASSWORD=
ZEN_DEFAULT_STUDENT_PASSWORD=
