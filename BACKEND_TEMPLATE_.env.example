# ===========================================
# Progz Backend — Linode .env (copy to .env)
# ===========================================
# Run on server:
#   cd ~/progz_backend
#   cp .env.example .env
#   nano .env   (fill values, save)
#   npm run start

PORT=5002
NODE_ENV=production

# MongoDB — REQUIRED (server won't start without this)
# MongoDB Atlas example:
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/progz?retryWrites=true&w=majority
# Or local Mongo on Linode:
# MONGO_URI=mongodb://127.0.0.1:27017/progz

# JWT
JWT_SECRET=your-long-random-secret-key-here
JWT_EXPIRE=7d

# Optional
FRONTEND_URL=https://progz.urbancode.in
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
